%This function is used to detect rings in an image.
%Currently the function uses the openCV, numpy and pandas library from
%python since there is no equivalent function to the openCV Sobel() in
%MATLAB and attempts to make one have been unsuccessful as of now.
%Anoter function called transpose is used from numpy for sub pixel
%accuracy
%curv threshold has been defined as  curv_thresh = median(prin_curv(:))-(curv_thresh_ratio*std(prin_curv(:)));
% the threshold is in terms of how many standard deviations from the median
% just to make the code run faster
%Implemented my Marwan Malik, mamalik@ukaachen.de
function rings = Ring_detector(img, Rmin, Rmax, kernal_size, circle_thresh, sigma, curv_thresh_ratio, vote_thresh, sub_pxl, grad)
    % Import the cv2, numpy and pandas modules
    cv2 = py.importlib.import_module('cv2');
    np = py.importlib.import_module('numpy');
    pd = py.importlib.import_module('pandas');
    ndimage = py.importlib.import_module('scipy.ndimage');

    % Define the default variable parameters
    if nargin < 2 || isempty(Rmin)
        Rmin = 4; 
    end
    if nargin < 3 || isempty(Rmax)
        Rmax = 50;
    end
    if nargin < 4 || isempty(kernal_size)
        kernal_size = 3;
    end
    if nargin < 5 || isempty(circle_thresh)
        circle_thresh = 2*pi*0.33;
    end
    if nargin < 6 || isempty(sigma)
        sigma = 0.8;
    end
    if nargin < 7 || isempty(curv_thresh_ratio)
        curv_thresh_ratio = 0.2;
    end
    if nargin < 8 || isempty(vote_thresh)
        vote_thresh = 3;
    end
    if nargin < 9 || isempty(sub_pxl)
        sub_pxl = true;
    end
    if nargin < 10 || isempty(grad)
        grad = false;
    end
    
    % Convert the MATLAB array to a numpy array with the correct shape
    img = im2gray(img);
    img_np = py.numpy.array(img, pyargs('dtype', 'float32'));
    img_np = np.float32(img_np);
    % Apply Gaussian blur
    img_blurred = cv2.GaussianBlur(img_np, py.tuple({int8(0), int8(0)}), double(sigma));
    d_mag = ndimage.gaussian_gradient_magnitude(img_blurred, single(1.0));
    if grad
        img_blurred = d_mag;
    end
    % Apply Sobel function to calculate the second order derivatives
    Lxx = cv2.Sobel(img_blurred, cv2.CV_32F, int32(2), int32(0), ksize=int32(kernal_size));  % Second derivative in x direction
    Lyy = cv2.Sobel(img_blurred, cv2.CV_32F, int32(0), int32(2), ksize=int32(kernal_size));  % Second derivative in y direction
    Lxy = cv2.Sobel(img_blurred, cv2.CV_32F, int32(1), int32(1), ksize=int32(kernal_size));  % Second derivative in x and y direction
    
    % Convert the numpy arrays to pandas dataframes 
    Lxx_df = pd.DataFrame(Lxx);
    Lxy_df = pd.DataFrame(Lxy);
    Lyy_df = pd.DataFrame(Lyy);
    
    % Convert the numpy arrays to MATLAB arrays
    Lxx_np = py.numpy.array(Lxx_df); % convert dataframe to numpy array
    Lxx_mat = single(Lxx_np); % convert numpy array to matlab matrix
    Lyy_np = py.numpy.array(Lyy_df);
    Lyy_mat = single(Lyy_np);
    Lxy_np = py.numpy.array(Lxy_df);
    Lxy_mat = single(Lxy_np);
    
    %Get the least principle curvature using the second order derivatives
    
    prin_curv = least_principal_curvature(Lxx_mat, Lyy_mat, Lxy_mat);
    curv_thresh = -50;%median(prin_curv(:))-(curv_thresh_ratio*std(prin_curv(:)));
    ht_out = ridge_circle_hough_transform(Lxx_mat, Lyy_mat, Lxy_mat, prin_curv, curv_thresh, Rmin, Rmax);
    [Nrows, Ncols] = size(prin_curv);
    rings = votes2rings(ht_out.votes, Rmin, Rmax, Nrows, Ncols, vote_thresh, circle_thresh);
    if sub_pxl && ~isempty(rings)
        rings = subpxl_circles(rings, ht_out.directed_ridges, Nrows, Ncols, Rmin, Rmax);
    end
end

% Compute the least principal curvature of a Hessian matrix for a 2D array
function curv = least_principal_curvature(Lxx, Lyy, Lxy)
    % Check the input arguments and initialize the output array
    assert(~isempty(Lxx) && ~isempty(Lyy) && ~isempty(Lxy));
    Lxx = double(Lxx);
    Lyy = double(Lyy);
    Lxy = double(Lxy);
    % Compute the minimum eigenvalue of the 2x2 Hessian matrix for all pixels
    curv = 0.5 * (Lxx + Lyy - sqrt((Lxx - Lyy).^2 + 4 * Lxy.^2));
end
function [ht_out] = ridge_circle_hough_transform(Lxx, Lyy, Lxy, curv, curv_thresh, Rmin, Rmax)
    %This function performs the hough transform
    cos_q_pi = cos(pi/8); % cosine of pi/8
    % Check if the inputs are valid
    assert(~isempty(Lxx) && ~isempty(Lyy) && ~isempty(Lxy) && ~isempty(curv));
    assert(isscalar(curv_thresh) && isscalar(Rmin) && isscalar(Rmax));
    assert(Rmin == floor(Rmin) && Rmax == floor(Rmax));
    % Initialize the variables
    Rmin = Rmin - 1;
    Rmax = Rmax + 1;
    [Nrows, Ncols] = size(curv);
    Nrads = Rmax - Rmin + 1;
    
    % Initialize the arrays for the row indices, column indices, and values
    row_indices = zeros(1, Nrows * Ncols);
    col_indices = zeros(1, Nrows * Ncols);
    values = zeros(1, Nrows * Ncols);

    % Initialize a counter for the number of non-zero entries
    nnz_counter = 0;

    counter = 1;
    votes = zeros(Nrows * Ncols * Nrads * 2, 1, "uint32");
    
    % Create an empty structure ht_out
    ht_out = struct();
    
    % Create a logical matrix
    mask = curv > curv_thresh;

    % Iterate over all image entries (principal curv in this case)
    % Avoid dealing with the boundaries by iterating over all but the entries
    % on the exterior
    for i = 2:Nrows-1
        for j = 2:Ncols-1
            % Find ridges
            % Threshold the curvature
            if mask(i,j)
                continue;
            end
            % Perform non-minimum suppression in the least principal direction
            [cosQ, sinQ] = least_principal_direction(Lxx(i,j), Lyy(i,j), Lxy(i,j));
            if abs(cosQ) > cos_q_pi
                if (curv(i,j) >= curv(i,j+1)) || (curv(i,j) >= curv(i,j-1))
                    continue;
                end
            elseif abs(sinQ) > cos_q_pi
                if (curv(i,j) >= curv(i+1,j)) || (curv(i,j) >= curv(i-1,j))
                    continue;
                end
            elseif sign(sinQ) == sign(cosQ)
                if (curv(i,j) >= curv(i+1,j+1)) || (curv(i,j) >= curv(i-1,j-1))
                    continue;
                end
            elseif sign(sinQ) ~= sign(cosQ)
                if (curv(i,j) >= curv(i-1,j+1)) || (curv(i,j) >= curv(i+1,j-1))
                    continue;
                end
            end
            % Add the least principal direction to the ridge sparse array
            nnz_counter = nnz_counter + 1;
            row_indices(nnz_counter) = i-1;
            col_indices(nnz_counter) = j-1;
            values(nnz_counter) = complex(cosQ, sinQ);
            
            % Circle Hough transform
            % TODO: consider Bresenham circle(arcs) instead of Gaussian
            % smoothing
            
            x0 = round(sinQ * Rmin);
            y0 = round(cosQ * Rmin);
            x1 = round(sinQ * Rmax);
            y1 = round(cosQ * Rmax);
            %Remove iterations were x0, y0, x1 or y1 is NaN

            % Check if x0 or x1 is NaN
            if isnan(x0) || isnan(x1) || isnan(y0) || isnan(y1)
                fprintf('Warning: x0, y0, y1 or x1 is NaN. Skipping this iteration.\n');
                continue;
            end
            vote4xy = vote4(Rmin, x0, y0, Rmax, x1, y1);
            for s = -1:2:1
                % For the inwards and outwards without the zero (inplace)
                for r_ = 1:Nrads
                    x = (i-1) + (s * vote4xy(r_, 1));
                    y = (j-1) + (s * vote4xy(r_, 2));
                    r = r_ + Rmin-1;
                    
                    if (x >= Nrows-1) || (y >= Ncols-1) || (x < 0) || (y < 0)
                        break;
                    end
                    votes(counter) = convert_coord(r, x, y);
                    counter = counter + 1;
                end
            end
        end
    end
    votes = votes(1:counter);
    votes = nonzeros(votes);
    votes = sort(votes);
    
    % After your loop, create the sparse matrix
    directed_ridges = sparse(row_indices(1:nnz_counter), col_indices(1:nnz_counter), values(1:nnz_counter), Nrows, Ncols);
    
    % Assign the values of directed_ridges and votes to the fields of ht_out
    ht_out.directed_ridges = directed_ridges;
    ht_out.votes = votes;
end
%Change rij2coord and coord2rij
function rings = votes2rings(votes, Rmin, Rmax, Nrows, Ncols, vote_thresh, circle_thresh)
    % Assert that votes is not empty and vote_thresh is positive
    assert(~isempty(votes), 'votes must not be empty');
    assert(vote_thresh > 0, 'vote_thresh must be a positive integer');
    % Initialize variables
    Rmin = Rmin - 1;
    Rmax = Rmax + 1;
    rate = 0.05; % 0.05 in the Afik (2015), SciRep; doi: 10.1038/srep13584 
    ksigma = rate * Rmax + 0.25;
    ksize = round(4 * ksigma + 1);
    if mod(ksize,2) == 0 
        ksize = ksize+1;
    end
    if ksize == 1
        ksize = 3;
    end
    kernel = zeros(ksize, 1);
    R = Rmin;
    votes_size = size(votes, 1);
    Rmod = mod(R, 3);
    %Nrads = Rmax - Rmin + 1;
    hough_slice = zeros(3, Nrows, Ncols);
    smoothed_slice = zeros(3, Nrows, Ncols);
    hough_modified = zeros(3, Nrows * Ncols, 2);
    hough_counter = zeros(3, 1);
    hough_hotspots = zeros(3, Nrows * Ncols, 2);
    hotspots_counter = zeros(3, 1);
    MaxRingsNo = 1000;
    rings = zeros(MaxRingsNo, 4);
    ring_counter = 0;
    one = 1;
    rij = votes(one);
    coords = convert_rij(votes);

    % FIRST: populate the first two radius slabs, (and smooth each one in its 
    % turn). Then exit this loop, and continue for the rest at "SECOND" (no
    % need for local max search as the Rmin_ is there just for correct local
    % max search)
    for n = 2:votes_size
        r = coords.r(one); i = coords.i(one); j = coords.j(one);
        if r == R
            % populate the r%3 plane
            hough_slice(Rmod+1,i+1,j+1) = hough_slice(Rmod+1,i+1,j+1) + 1;
            rij_nxt = votes(n);
            if rij_nxt ~= rij
                hough_modified(Rmod+1, hough_counter(Rmod+1)+1,:) = [i, j];
                hough_counter(Rmod+1) = hough_counter(Rmod+1) + 1;
                if hough_slice(Rmod+1,i+1,j+1) >= vote_thresh
                    hough_hotspots(Rmod+1, hotspots_counter(Rmod+1)+1,:) = [i, j];
                    hotspots_counter(Rmod+1) = hotspots_counter(Rmod+1) + 1;
                end
                rij = rij_nxt;
                
            end
        else
            % smooth the R plane of the Hough space.
            ksigma = double(rate) * double(R) + 0.25;
            ksize = round(4 * ksigma + 1); % bitwise OR with 1 adds one to even int
            if mod(ksize, 2) == 0 
                ksize = ksize+1;
            end
            if ksize == 1
                ksize = 3;
            end
            kcentre = floor(ksize / 2);
            kscale2x = -0.5 / ksigma^2;
            
            for ki = 1:ksize
                kernel(ki) = exp(double(kscale2x) * double((ki - 1 - kcentre)^2));
            end
    
            for hot = 1:hotspots_counter(Rmod+1)
                i = hough_hotspots(Rmod+1,hot,1);
                j = hough_hotspots(Rmod+1,hot,2);
                from_row = max(double(i) - kcentre, 0);
                to_row = min(double(i) + kcentre + 1, Nrows);
                from_col = max(double(j) - kcentre, 0);
                to_col = min(double(j) + kcentre + 1, Ncols);
                value = 0;
                for x = from_row:(to_row-1)
                    ki = x + kcentre - double(i);
                    for y = from_col:(to_col-1)
                        kj = y + kcentre - double(j);
                        value = value + hough_slice(Rmod+1,x+1,y+1) * kernel(ki+1) * kernel(kj+1);
                    end
                end
                smoothed_slice(Rmod+1,i+1,j+1) = value / double(R);
            end
    
            R = r;
            Rmod = mod(R, 3);
            rij = votes(n);
            if R == Rmin + 2
                break;
            end
            
        end
        one = one +1;
    end
    % SECOND: account for Rmin+2 till Rmax-2 including local max finding, and
    % smoothing the Rmax-1 (local max not searched for in the Rmax-1 & Rmax
    % slabs at this stage)
    %Even though not nested with the above loop it still needs to know
    %which n to start at.
    for n = n:votes_size
        r = coords.r(one); i = coords.i(one); j = coords.j(one);
        if r == R
            % populate the r%3 plane
            hough_slice(Rmod+1,i+1,j+1) = hough_slice(Rmod+1,i+1,j+1) + 1;
            rij_nxt = votes(n);
            if rij_nxt ~= rij
                hough_modified(Rmod+1, hough_counter(Rmod+1)+1,:) = [i, j];
                hough_counter(Rmod+1) = hough_counter(Rmod+1) + 1;
                if hough_slice(Rmod+1,i+1,j+1) >= vote_thresh
                    hough_hotspots(Rmod+1, hotspots_counter(Rmod+1)+1,:) = [i, j];
                    hotspots_counter(Rmod+1) = hotspots_counter(Rmod+1) + 1;
                end
                rij = rij_nxt;
            end
        else
            % smooth the R plane of the Hough space.
            ksigma = double(rate) * double(R) + 0.25;
            ksize = round(4 * ksigma + 1); % bitwise OR with 1 adds one to even int
            if mod(ksize, 2) == 0
                ksize = ksize +1;
            end
            if ksize == 1
                ksize = 3;
            end
            kcentre = floor(ksize / 2);
            kscale2x = -0.5 / ksigma^2;
            
            for ki = 1:ksize
                kernel(ki) = exp(double(kscale2x) * double((ki - 1 - kcentre)^2));
            end
    
            for hot = 1:hotspots_counter(Rmod+1)
                i = hough_hotspots(Rmod+1,hot,1);
                j = hough_hotspots(Rmod+1,hot,2);
                from_row = max(double(i) - kcentre, 0);
                to_row = min(double(i) + kcentre + 1, Nrows);
                from_col = max(double(j) - kcentre, 0);
                to_col = min(double(j) + kcentre + 1, Ncols);
                value = 0;
                for x = from_row:(to_row-1)
                    ki = x + kcentre - double(i);
                    for y = from_col:(to_col-1)
                        kj = y + kcentre - double(j);                        
                        value = value + hough_slice(Rmod+1,x+1,y+1) * kernel(ki+1) * kernel(kj+1);
                    end
                end
                smoothed_slice(Rmod+1,i+1,j+1) = value / double(R);
            end
    
            % find local max in the 3D sparse Hough space
            R_ = mod(R+1, 3) + 1;
            Ro = R - 1;
            Romod = mod(Ro, 3) + 1;
    
            for hot = 1:hotspots_counter(Romod)
                i = hough_hotspots(Romod,hot,1);
                j = hough_hotspots(Romod,hot,2);
                vote = smoothed_slice(Romod,i+1,j+1);
                if vote < circle_thresh
                    continue;
                end
                local_max = true;
                for k = 1:3
                    for di = -1:1
                        for dj = -1:1
                            ii = i+di+1; 
                            ii = ii+ (ii < 1)*Nrows; %Wrap around effect
                            jj = j+dj+1; 
                            jj = jj+ (jj < 1)*Ncols; %Wrap around effect
                            local_max = local_max && (vote >= smoothed_slice(k,ii,jj));
                        end
                    end
                end
                if local_max
                    rings(ring_counter+1,:) = [i, j, Ro];
                    ring_counter = ring_counter + 1;
                end
            end
    
            % then clean the (R+One)%Three:
            for hot = 1:hough_counter(R_)
                i = hough_modified(R_,hot,1);
                j = hough_modified(R_,hot,2);
                hough_slice(R_,i+1,j+1) = 0;
            end
            for hot = 1:hotspots_counter(R_)
                i = hough_hotspots(R_,hot,1);
                j = hough_hotspots(R_,hot,2);
                smoothed_slice(R_,i+1,j+1) = 0;
            end
            hough_counter(R_) = 0;
            hotspots_counter(R_) = 0;
            R = r;
            Rmod = mod(R, 3); %Removed a plus 1 from here
            rij = votes(n);
        end
        one = one +1;
    end
    %THIRD
    % smooth the Rmax+1 and find local maximum in Rmax, skip clean up:
    ksigma = double(rate) * double(R) + 0.25;
    ksize = round(4 * ksigma + 1); % bitwise OR with 1 adds one to even int
    if mod(ksize, 2) == 0
        ksize = ksize +1;
    end
    if ksize == 1
        ksize = 3;
    end
    kcentre = floor(ksize / 2);
    kscale2x = -0.5 / ksigma^2;
    
    for ki = 1:ksize
        kernel(ki) = exp(double(kscale2x) * double((ki -1 - kcentre)^2));
    end
    
    for hot = 1:hotspots_counter(Rmod+1)
        i = hough_hotspots(Rmod+1,hot,1);
        j = hough_hotspots(Rmod+1,hot,2);
        from_row = max(double(i) - kcentre, 0);
        to_row = min(double(i) + kcentre + 1, Nrows);
        from_col = max(double(j) - kcentre, 0);
        to_col = min(double(j) + kcentre + 1, Ncols);
        value = 0;
        for x = from_row:(to_row-1)
            ki = x + kcentre - double(i);
            for y = from_col:(to_col-1)
                kj = y + kcentre - double(j);
                value = value + hough_slice(Rmod+1,x+1,y+1) * kernel(ki+1) * kernel(kj+1);
            end
        end
        smoothed_slice(Rmod+1,i+1,j+1) = value / double(R);
    end
    
    % find local max in the 3D sparse Hough space
    %
    % R_ = mod(R+1, 3) + 1;
    Ro = R - 1;
    Romod = mod(Ro, 3) + 1;
    
    for hot = 1:hotspots_counter(Romod)
        i = hough_hotspots(Romod,hot,1);
        j = hough_hotspots(Romod,hot,2);
        vote = smoothed_slice(Romod,i+1,j+1);
        if vote < circle_thresh
            continue;
        end
        local_max = true;
        for k = 1:3
            for di = -1:1
                for dj = -1:1
                    ii = i+di+1; 
                    ii = ii+ (ii < 1)*Nrows; %Wrap around effect
                    jj = j+dj+1; 
                    jj = jj+ (jj < 1)*Ncols; %Wrap around effect
                    local_max = local_max && (vote >= smoothed_slice(k,ii,jj));
                end
            end
        end
        if local_max
            ring_counter = ring_counter + 1;
            rings(ring_counter,:) = [i, j, Ro];
        end
    end
    
    rings = rings(1:ring_counter,:);

end

%Define a method for detecting sub_pxl circles from here
function rings_subpxl = subpxl_circles(rings, directed_ridges, Nrows, Ncols, Rmin, Rmax, thickness, eccentricity)
    % Check if the inputs are valid
    assert(~isempty(rings) && ~isempty(directed_ridges));
    assert(isscalar(Nrows) && isscalar(Ncols) && Nrows == floor(Nrows) && Ncols == floor(Ncols));
    assert(isscalar(Rmin) && isscalar(Rmax) && Rmin == floor(Rmin) && Rmax == floor(Rmax));
    if nargin < 7
        thickness = 3;
    end
    if nargin < 8
        eccentricity = 0;
    end
    assert(isscalar(thickness) && thickness == floor(thickness));
    assert(isscalar(eccentricity));
    %rings = flipud(rings);
    % Initialize the variables
    rings_size = size(rings, 1);
    img_mask = zeros(Nrows, Ncols, 'uint8');
    rings_subpxl = zeros(rings_size, 4, "single");
    
    % Find non-zero values in directed_ridges
    [i, j] = find(directed_ridges);
    
    % Loop over non-zero elements
    for k = 1:numel(i)
        img_mask(i(k)+1, j(k)+1) = img_mask(i(k)+1, j(k)+1) + 1;
    end



    % Perform sub-pixel correction for each ring
    for n = 1:rings_size
        i = rings(n, 1);
        j = rings(n, 2);
        r = rings(n, 3);
        c = rings(n, 4)/1e6;
        subpxled = true;
        % Get the ring mask for the annulus (function call)
        ring_mask = get_ring_mask(r, thickness);
        % Calculate the size of the ring mask
        
        % Account for the image borders
        row_min = max(i - r - thickness, 0);
        row_max = min(i + r + thickness + 1, Nrows);
        col_min = max(j - r - thickness, 0);
        col_max = min(j + r + thickness + 1, Ncols);
        % Find the coordinates of the ridge pixels within the annulus
        %[x, y] = find(img_mask(row_min+1:row_max, col_min+1:col_max) && ring_mask(row_min-i+r+thickness+1:r+thickness+row_max-i+1, col_min-j+r+thickness+1:r+thickness+col_max-j+1));
        % Adjust the indices used to slice the img_mask matrix
        %Possible wrap around effect error
        
        img_mask_slice = img_mask((row_min+1):row_max, (col_min+1):col_max);
        
        ring_mask_slice = ring_mask((row_min-i+r+thickness+1):(r+thickness+row_max-i), (col_min-j+r+thickness+1):(r+thickness+col_max-j));
        % Perform the bitwise AND operation
       % Perform the bitwise AND operation
        % Perform the bitwise AND operation
        % Convert MATLAB arrays to numpy arrays
        img_mask_slice_np = py.numpy.array(img_mask_slice);
        ring_mask_slice_np = py.numpy.array(ring_mask_slice);
        
        % Perform the bitwise AND operation using numpy
        bitwise_and_result_np = py.numpy.bitwise_and(img_mask_slice_np, ring_mask_slice_np);
        
        % Find the non-zero elements using numpy
        coords_np = py.numpy.transpose(py.numpy.nonzero(bitwise_and_result_np));
        %coords_df = pd.DataFrame(coords_np);
        % Convert the numpy array to a MATLAB array
        %coords_np = py.numpy.array(Lxx_df);
        %coords_np = py.numpy.array(coords_df);
        coords = single(coords_np);
        coords = uint8(coords);
        %coords = double(py.array.array2mat(coords_np));

        if eccentricity
            % Eccentricity larger than zero, that is, requested an ellipse fit
            % Make sure that fitEllipse does not crash
            % But better remove circles which do not have enough points on the
            % circumference
            if length(coords) > 5
                [cntr, MajAx, Tilt] = fitEllipse(coords);
                % Skip if the fit results in an eccentric ellipse
                if sqrt(1 - MajAx(1)^2 / MajAx(2)^2) < eccentricity
                    R = sqrt(MajAx(1) * MajAx(2)) / 2;
                else
                    subpxled = false;
                end
            else
                subpxled = false;
            end
        else
            % Eccentricity == 0, that is, need to fit to a circle
            if length(coords) > 3
                [cntr, R] = fitCircle(coords, i - row_min, j - col_min);
            else
                subpxled = false;
                R = r;
            end
        end

        % Check the radius range

        if (R + 0.5 < Rmin) || (R - 0.5 > Rmax)
            subpxled = false;
        end
        
        if ~subpxled
            cntr = [0, 0];
            R = 0;
        end
        % Skip in case the circle fit is based on less than half its
        % circumference
        %if (r < Rmin) || (r > Rmax) || (size(coords, 1) < pi * r)
        %    continue;
        %end
        rings_subpxl(n, 1) = cntr(1) + row_min;
        rings_subpxl(n, 2) = cntr(2) + col_min;
        rings_subpxl(n, 3) = R;
        rings_subpxl(n, 4) = c;
    end
end
function [cosine, sine] = least_principal_direction(Lxx, Lyy, Lxy)
    % Compute the directions using the formula from the Cython code
    D = 0.5 * (Lxx - Lyy) ./ (Lxy + eps);  % Add a small constant to the denominator
    tangent = zeros(size(D));
    tangent(Lxy > 0) = -D(Lxy > 0) - sqrt(D(Lxy > 0).^2 + 1);
    tangent(Lxy <= 0) = -D(Lxy <= 0) + sqrt(D(Lxy <= 0).^2 + 1);
    
    % Handle the case when Lxy is zero
    if Lxx < Lyy
        tangent(Lxy == 0) = 0;
    elseif Lxx > Lyy
        tangent(Lxy == 0) = inf;
    else  % Lxx == Lyy
        tangent(Lxy == 0) = 1;  % Or any other value that makes sense
    end
    
    denominator = sqrt(1 + tangent.^2);
    cosine = 1 ./ denominator;
    sine = tangent ./ denominator;
end

% Define a function to convert the Bresenham line algorithm
function coords = vote4(Rmin, x0, y0, Rmax, x1, y1)
    % Check if the inputs are integers
    assert(all([Rmin, x0, y0, Rmax, x1, y1] == floor([Rmin, x0, y0, Rmax, x1, y1])));
    % Initialize the variables
    dr = Rmax - Rmin;
    sr = 1;
    coords = zeros(dr+1, 2, "int64");
    dr2 = 2 * dr;
    
    % Fill x
    dx = abs(x1 - x0);
    %sx = sign(x1 - x0);
    if (x1>x0)
        sx = 1;
    else
        sx = -1;
    end
    dx2 = 2 * dx;
    d = dx2 - dr;
    for i = 1:dr+1
        coords(i, 1) = x0;
        while d >= 0
            x0 = x0 + sx;
            d = d - dr2;
        end
        d = d + dx2;
    end
    
    % Fill y
    dx = abs(y1 - y0);
    %sx = sign(y1 - y0);
    if (y1>y0)
        sx = 1;
    else
        sx = -1;
    end
    dx2 = 2 * dx;
    d = dx2 - dr;
    for i = 1:dr+1
        coords(i, 2) = y0;
        while d >= 0
            y0 = y0 + sx;
            d = d - dr2;
        end
        d = d + dx2;
    end
end

function coord2rij = convert_coord(r, i, j)

% Check the number of input arguments
if nargin < 3
    error('At least three input arguments are required');
end

MaxCols = 1936;
MaxRows = 1456;
shiftRows = ceil(log2(MaxCols));
shiftRads = shiftRows + ceil(log2(MaxRows));

coord2rij = j + bitshift(i, shiftRows) + bitshift(r, shiftRads);
end

function coords = convert_rij(votes, shiftRows, shiftRads, modRows, modCols)

    MaxRows = 1456;
    MaxCols = 1936;
    shiftRows = ceil(log2(MaxCols));
    shiftRads = shiftRows + ceil(log2(MaxRows));
    modCols = bitshift(1, shiftRows) - 1;
    modRows = bitshift(1, shiftRads) - 1;

    % Perform the bit-wise operations to convert the rij format
    coords.r = bitshift(votes, -shiftRads);
    coords.i = bitshift(bitand(votes, modRows), -shiftRows);
    coords.j = bitand(votes, modCols);
end

function ring_mask = get_ring_mask(r, dr)
    % Generate mask not considering the borders yet
    [y, x] = ndgrid(-r-dr:r+dr, -r-dr:r+dr);
    ring_mask = abs(x.^2 + y.^2 - r^2 - dr^2) <= 2 * r * dr;
end

% Define a function to perform fitCircle
function [centre, R] = fitCircle(coords, i, j)
    % Ensure inputs are double precision
    coords = double(coords);
    i = double(i);
    j = double(j);

    % Define a function to calculate the distance of each 2D point from the center c=(xc, yc)
    function Ri = calc_R(centre)
        Ri = sqrt((coords(:,1) - centre(1)).^2 + (coords(:,2) - centre(2)).^2);
    end

    % Define a function to calculate the algebraic distance between the 2D points and the mean circle centered at c=(xc, yc)
    function F = cost_fn(centre)
        Ri = calc_R(centre);
        F = Ri - mean(Ri);
    end

    options = optimoptions('lsqnonlin', 'Display', 'none');
    centre = lsqnonlin(@cost_fn, [i, j], [], [], options);
    
    Ri = calc_R(centre);
    R = mean(Ri);
end
